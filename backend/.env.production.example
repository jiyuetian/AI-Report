# 投产配置模板 —— Task #716（本文件只是模板，应用只读取 backend/.env）
#
# 使用方式：
#   1. 复制本文件为 backend/.env（或由部署平台按变量名注入环境变量，优先级高于 .env）
#   2. 所有 __REPLACE__ / __INJECT__ 占位项必须由密钥管理服务或环境变量提供
#   3. 严禁把真实 API key / 数据库口令 / SECRET_KEY 提交进仓库
#   4. 部署后访问 /api/v1/health，确认 deployment.production_ready == true
#      并核对启动日志里没有 [POSTURE-BLOCK]
#
# 与本地 dev 的关键差异（4 个阻断项）：
#   DEBUG=false / ENABLE_INTERNAL_ENDPOINTS=false / ENABLE_API_DOCS=false / 强 SECRET_KEY

DEBUG=false
ENABLE_INTERNAL_ENDPOINTS=false
ENABLE_API_DOCS=false

# 生成示例：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=__REPLACE_WITH_RANDOM_64_HEX_CHARS__
ACCESS_TOKEN_EXPIRE_MINUTES=120

# 元数据库：生产建议 PostgreSQL，口令走环境变量，不写进文件
DATABASE_URL=__INJECT_VIA_ENV__
DB_FALLBACK_SQLITE=false
REDIS_URL=__INJECT_VIA_ENV__
# 本地无 Redis 时设 REDIS_DISABLED=1 走内存兜底；生产有 Redis 时删除此行
# REDIS_DISABLED=1

MAX_FILE_SIZE=104857600
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports
DUCKDB_PATH=./data/duckdb/aibi.db

# LLM provider 链：整段 JSON 由环境变量注入，模板内不留任何明文 key
LLM_PROVIDERS=__INJECT_VIA_ENV__
LLM_FUNCTION_CALLING=true
LLM_JSON_MODE=true

# 大脑阶段开关（与 dev 保持一致，AI 主执行 + 规则兜底）
BRAIN_S2_USE_LLM=true
BRAIN_TASK_TOKEN_BUDGET=8000
BRAIN_S3_LLM_TIMEOUT=180.0
