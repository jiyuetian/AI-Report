# 数据库（0.3 环境隔离：一个后端只对一个库，业务库与元数据必须分开）
# 业务数据 DuckDB（图表数值来源）——演示/生产指向真实数据，禁止静默默认
DUCKDB_PATH=./data/duckdb/qa_aibi.db
# 元数据 SQLite（用户/看板/版本/分享）——独立文件，不要与 DUCKDB_PATH 指向同一文件
DATABASE_URL=sqlite+aiosqlite:///./data/aibi.db
REDIS_URL=redis://localhost:6379/0

# LLM配置
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_MODEL=kimi-latest

# 文件上传
MAX_FILE_SIZE=104857600
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports

# 安全
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 调试
DEBUG=true