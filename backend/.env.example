# 数据库（0.3 环境隔离：一个后端只对一个库，业务库与元数据必须分开）
# 业务数据 DuckDB（图表数值来源）——唯一正确位置，勿改指向 qa_aibi.db（那是元数据库）
# 历史坑：此处曾写 qa_aibi.db，照抄会导致新数据集建表进旧库、老看板全空（P0-2 双库错配）
# 相对路径会由 config.py 按 backend 根解析为绝对路径，不依赖启动目录
DUCKDB_PATH=./data/duckdb/aibi.db
# 元数据 SQLite（用户/看板/版本/分享）——独立文件，不要与 DUCKDB_PATH 指向同一文件
DATABASE_URL=sqlite+aiosqlite:///./data/aibi.db
REDIS_URL=redis://localhost:6379/0

# LLM配置
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_MODEL=kimi-latest

# 文件上传
MAX_FILE_SIZE=104857600
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports

# 安全
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 调试
DEBUG=true